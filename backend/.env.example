# Database
DATABASE_URL=postgresql://forexai:forexai123@localhost:5432/forexai_dev
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=your-encryption-key-32-chars-long-base64 encoded key for Fernet

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_AI_MODEL=claude-3-opus

# WebSocket Configuration
WEBSOCKET_SERVER_PORT=8765
CLIENT_HEARTBEAT_INTERVAL=30
CONNECTION_TIMEOUT=60

# User EA Configuration
EA_DOWNLOAD_URL=https://your-platform.com/downloads/ea/{user_id}
SETUP_GUIDE_URL=https://your-platform.com/setup/{user_token}

# Trading Config
MAX_OPEN_TRADES=10
RISK_PER_TRADE=0.01
DEFAULT_TIMEFRAME=1h
COMMISSION_RATE=0.001
PROFIT_COMMISSION_RATE=0.10

# External Services
SENTRY_DSN=your-sentry-dsn-optional
STRIPE_API_KEY=your-stripe-key-optional
SENDGRID_API_KEY=your-sendgrid-key-optional

# Development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Freqtrade Configuration
FREQTRADE_API_URL=http://localhost:8080
FREQTRADE_WS_URL=ws://localhost:8080
